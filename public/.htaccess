# ============================================================
# Twin Hooks Storefront — Hostinger Production .htaccess
# ============================================================

# ── 1. Enable Rewrite Engine ─────────────────────────────────
Options -MultiViews
RewriteEngine On

# ── 2. Force HTTPS (SSL confirmed active) ──
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── 3. SPA Fallback (React HashRouter — all routes via index.html) ─
#     Since the app uses HashRouter (#/shop etc.) direct file
#     requests still go to index.html and the hash does the routing.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [QSA,L]

# ── 4. Block access to sensitive files ───────────────────────
<FilesMatch "(\.env|\.env\.local|\.env\.production|\.git|\.gitignore|bun\.lockb|package-lock\.json|package\.json|tsconfig.*|vite\.config.*|tailwind\.config.*|postcss\.config.*)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ── 5. Block directory listing ────────────────────────────────
Options -Indexes

# ── 6. Security Headers ──────────────────────────────────────
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    # Prevent MIME sniffing
    Header always set X-Content-Type-Options "nosniff"
    # XSS protection
    Header always set X-XSS-Protection "1; mode=block"
    # Referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Permissions policy
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # HSTS
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    # Content Security Policy — allows Firebase, Cloudinary, Google Fonts, WhatsApp, QR API
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://res.cloudinary.com https://api.qrserver.com https://*.googleusercontent.com; connect-src 'self' https://*.firebaseio.com https://*.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://api.cloudinary.com wss://*.firebaseio.com; frame-src 'none'; object-src 'none';"
    # Remove server signature
    Header unset Server
    Header unset X-Powered-By
</IfModule>

# ── 7. Static Asset Caching ───────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    # HTML — no cache (SPA entry point changes on deploy)
    ExpiresByType text/html "access plus 0 seconds"
    # JS/CSS bundles (Vite fingerprints these)
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    # Images
    ExpiresByType image/png "access plus 6 months"
    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType image/webp "access plus 6 months"
    ExpiresByType image/svg+xml "access plus 6 months"
    ExpiresByType image/ico "access plus 1 year"
    # Fonts
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    # JSON / Manifest
    ExpiresByType application/json "access plus 1 day"
    ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# ── 8. Gzip Compression ───────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml application/font-woff
    AddOutputFilterByType DEFLATE font/woff font/woff2
</IfModule>

# ── 9. Canonical trailing-slash removal (SEO) ─────────────────
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{THE_REQUEST} \s(.+?)/+\s
RewriteRule ^ /%1 [R=301,L]

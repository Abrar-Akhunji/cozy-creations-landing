# Twin Hooks Admin Panel — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# Firebase Configuration (same project as storefront)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:your_messaging_sender_id:web:your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Cloudinary Configuration (get from Cloudinary Dashboard > Settings > API Keys)
# NOTE: CLOUDINARY_API_SECRET must NEVER have VITE_ prefix — it stays server-side only
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_FOLDER=products

# Cloudinary Sign URL (Vite dev middleware route — do not change)
VITE_CLOUDINARY_SIGN_URL=/cloudinary-sign

# Cloudinary Cloud Name (public, safe to expose)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here

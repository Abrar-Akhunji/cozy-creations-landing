rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the authenticated user is an admin
    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) ||
        request.auth.token.email == 'moabrarakhunji@gmail.com' ||
        request.auth.token.email == 'twinhooks.art@gmail.com'
      );
    }

    // Admins collection:
    // - Admins have full access
    match /admins/{email} {
      allow read, write: if isAdmin();
    }

    // Products collection:
    // - Public read (customers browse products)
    // - Admin write (create, update, delete)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories collection:
    // - Public read (customers view category menu)
    // - Admin write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupons collection:
    // - Public read (needed to validate code at checkout)
    // - Admin write
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders collection:
    // - Anyone can create/place an order
    // - Anyone can read/query (customers query status by UTR/orderId)
    // - Admin update and delete
    match /orders/{orderId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // Metadata collection (for migration and settings)
    match /_meta/{metaId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
